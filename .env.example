# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=5182
# Public URL of the web app (used in notification deep-links)
APP_URL=http://localhost:5182

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://goscript:goscript@localhost:5435/goscriptai?schema=public

# ── Redis / BullMQ ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6383

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d

# ── Anthropic / Claude Agent SDK ──────────────────────────────────
# Agents run in deterministic STUB mode by default (no Claude needed) so the
# whole flow is testable in dev. To use REAL Claude models:
#   • Claude Max login: run the Claude Code login on the server, then set
#     AGENT_LIVE=1 and leave ANTHROPIC_API_KEY EMPTY (a set key overrides the
#     Max/OAuth login and the API rejects the request).
#   • API key billing: set ANTHROPIC_API_KEY (live mode turns on automatically).
AGENT_LIVE=
# Primary auth is Claude Max (Claude Code CLI login on the server).
# ANTHROPIC_API_KEY is the automatic fallback when Max is limited/down.
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_RETRIES=0

# ── Semantic search (optional) ────────────────────────────────────
# Voyage AI embeddings power semantic script search. Leave empty to use plain
# text search (code/title). voyage-3.5 is multilingual (MK/SQ), 1024-dim.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# ── Notifications ─────────────────────────────────────────────────
SES_REGION=eu-central-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@godigital.mk
TELEGRAM_BOT_TOKEN=

# ── Meta (Phase 2 — not used in Phase 1 runtime) ──────────────────
META_LONG_LIVED_TOKEN=

# ── Budgets (USD defaults, overridable from Settings) ─────────────
DEFAULT_CLIENT_BUDGET_USD=50
DEFAULT_SET_BUDGET_USD=8
