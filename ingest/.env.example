# Copy to .env and fill in. Do NOT commit .env.
GEMINI_API_KEY=
# Video-capable Gemini model. gemini-3.8-flash = fast + likely free quota;
# gemini-3.1-pro-preview = higher quality but needs billing. Run `npm run models`
# to see what your key can call.
GEMINI_MODEL=gemini-3.8-flash

# Only needed for --push (send results into GoScriptAI as PENDING brain).
API_URL=http://localhost:3011/api/v1
INGEST_EMAIL=admin@godigital.mk
INGEST_PASSWORD=goscript
