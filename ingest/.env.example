# Copy to .env and fill in. Do NOT commit .env.
GEMINI_API_KEY=
# Video-capable Gemini model(s). Use GEMINI_MODELS (comma-separated) to
# auto-rotate on the free-tier per-day cap (~20/model/day) — the tool switches
# to the next model when one runs out, so you can process more per day for free.
# Run `npm run models` to see what your key can call. For unlimited throughput,
# enable billing and a single model is fine.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.8-flash

# Only needed for --push (send results into GoScriptAI as PENDING brain).
API_URL=http://localhost:3011/api/v1
INGEST_EMAIL=admin@godigital.mk
INGEST_PASSWORD=goscript
